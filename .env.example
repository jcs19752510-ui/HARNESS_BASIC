# 환경변수 템플릿 — harness_13_tech_conventions.md §1 "필요한 환경변수 목록" 참조
#
# ⚠️ 이 파일에는 실제 값(비밀번호/토큰/키)을 절대 채우지 않습니다. 이 파일은
# "이 프로젝트를 로컬에서 띄우려면 어떤 환경변수가 필요한가"를 팀에게
# 안내하는 용도로만 씁니다. 실제 값은 각자 이 파일을 복사해서 만드는
# `.env`(저장소에 커밋되지 않음 — .gitignore 참조)에만 채우세요.
#
# git 저장소 접근(SSH 키, HTTPS Personal Access Token 등)은 이 파일이나
# 저장소 안 어디에도 두지 않습니다 — SSH 키는 ~/.ssh/, HTTPS PAT는 Git
# Credential Manager/OS 자격증명 관리자에 등록해서 씁니다
# (harness_13_tech_conventions.md §1 참조).
#
# 아래는 스택 확정 전 예시입니다 — Phase A에서 실제 스택을 확정하면
# 이 프로젝트가 실제로 쓰는 환경변수 이름으로 교체하세요.

# 데이터베이스 접속 문자열 (예시 — 실제 이름/포맷은 스택 확정 후 교체)
# DATABASE_URL=

# 세션/토큰 서명용 시크릿 (예시)
# SESSION_SECRET=

# 외부 API 연동 시 (예시)
# EXTERNAL_API_KEY=
