# 이 파일은 예시입니다 — 실제 값은 .env에만 넣고 절대 커밋하지 않습니다 (.gitignore 처리됨).
# 로컬 개발 시: cp .env.example .env  후 아래 값을 채우세요.

# NeonDB PostgreSQL 접속 문자열 (docs/workorder/attend_a1_workorder.md §0 참조)
DATABASE_URL=postgresql://user:password@host/dbname

# 세션 쿠키 서명 키 (itsdangerous) — openssl rand -hex 32 등으로 생성한 랜덤 값 사용
SESSION_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# 세션 쿠키 Secure 속성 — 운영은 true 고정, 로컬 HTTP 개발 시에만 false로 낮춤
# (docs/attend_adr.md ADR-007 참조)
SESSION_COOKIE_SECURE=true
